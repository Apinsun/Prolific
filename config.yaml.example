# Configuration Prolific — copier vers config.yaml et adapter

llm:
  provider: ollama            # MVP : uniquement ollama
  base_url: http://localhost:11434
  model: ""                   # défaut, surchargé par job / dropdown

comfyui:
  url: http://127.0.0.1:8188
  timeout: 300                # secondes max par génération

output:
  dir: ./output

server:
  host: 127.0.0.1
  port: 8000

datasets:
  dir: ./datasets             # CSVs (term, definition, category) à indexer

rag:
  embed_model: bge-m3         # modèle d'embedding Ollama (bge-m3 | nomic-embed-text)
  chroma_dir: ./chroma_db     # index vectoriel ChromaDB (gitignoré)

logging:
  level: INFO                 # DEBUG | INFO | WARNING | ERROR
  file: ""                    # vide = console uniquement ; ex : prolific.log

traces:
  enabled: true               # capture JSONL pour fine-tuning futur (gitignoré)
  dir: traces
